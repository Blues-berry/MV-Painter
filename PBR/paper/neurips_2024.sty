% Minimal neurips_2024 style file for compilation
% For actual submission, download the official style from neurips.cc

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neurips_2024}[2024/01/01 NeurIPS 2024 Style]

% Accept and ignore options like preprint
\DeclareOption*{}
\ProcessOptions\relax

% Page layout
\usepackage[margin=1in]{geometry}

% Title formatting
\renewcommand{\maketitle}{%
  \begin{center}
    {\LARGE\bfseries \@title \par}
    \vskip 1.5em
    {\large \@author \par}
    \vskip 1em
  \end{center}
}

% Abstract formatting
\renewenvironment{abstract}{%
  \begin{center}
    \textbf{Abstract}
  \end{center}
  \itshape
}{\par}

\endinput
